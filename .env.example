# Variáveis da LOJA (Next.js). Nenhuma delas é segredo: tudo com prefixo
# NEXT_PUBLIC_ é embutido no JavaScript que vai para o navegador.

# Origem da API. O painel fala com ela direto do navegador, então este valor
# também entra no `connect-src` da CSP.
NEXT_PUBLIC_API_URL=http://localhost:4001

# Usada só no servidor (rotas BFF em app/api). Dentro do compose aponta para o
# serviço, não para o host.
API_URL=http://api:4000

# Domínio público de leitura do bucket R2 das imagens de produto.
#
# Precisa ser o MESMO valor gravado no painel (Integrações → Imagens). Daqui
# saem duas coisas que só existem em tempo de build:
#   - o `img-src` da CSP — sem ele, o navegador bloqueia a foto;
#   - o `images.remotePatterns` do Next — sem ele, o next/image responde 400.
# Divergindo do painel, a página carrega normalmente e só a imagem some.
#
# Vazio é válido: a loja continua servindo as imagens de /public.
NEXT_PUBLIC_IMAGE_BASE_URL=

# `off`, `report-only` ou `enforce`. O padrão vale em produção e sai do
# caminho em desenvolvimento, onde o next dev usa eval.
# CSP_MODE=report-only
