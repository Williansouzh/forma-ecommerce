  "info": {
    "title": "c3dcriativ — API v1",
    "description": "Contrato da API da loja. Preços em CENTAVOS (inteiros) em todos os campos monetários.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Mesma origem"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ProductImageEmbed": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "alt"
        ]
      },
      "ProductVariantEmbed": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "colorHex": {
            "type": "string"
          },
          "priceAdjustment": {
            "type": "number"
          },
          "stock": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "priceAdjustment",
          "stock"
        ]
      },
      "DimensionsEmbed": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "depth": {
            "type": "number"
          }
        },
        "required": [
          "width",
          "height",
          "depth"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "shortDescription": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "originalPrice": {
            "type": "number"
          },
          "category": {
            "enum": [
              "decoracao",
              "geek",
              "presentes",
              "utilidades",
              "personalizados"
            ],
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductImageEmbed"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVariantEmbed"
            }
          },
          "material": {
            "type": "string"
          },
          "productionTime": {
            "type": "number"
          },
          "stock": {
            "type": "number",
            "description": "Peças prontas em estoque. Ausente = produção sob demanda."
          },
          "dimensions": {
            "$ref": "#/components/schemas/DimensionsEmbed"
          },
          "weight": {
            "type": "number"
          },
          "isAvailable": {
            "type": "boolean"
          },
          "isFeatured": {
            "type": "boolean"
          },
          "isCustom": {
            "type": "boolean",
            "description": "Peça que aceita personalização (nome, cor, medida) sob encomenda."
          },
          "badge": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "_id",
          "name",
          "slug",
          "description",
          "shortDescription",
          "price",
          "category",
          "tags",
          "images",
          "variants",
          "isAvailable",
          "isFeatured",
          "isCustom",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProductImageDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "url",
          "alt"
        ]
      },
      "ProductVariantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "colorHex": {
            "type": "string",
            "maxLength": 9
          },
          "priceAdjustment": {
            "type": "number",
            "default": 0
          },
          "stock": {
            "type": "number",
            "default": 0,
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "priceAdjustment",
          "stock"
        ]
      },
      "DimensionsDto": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          },
          "depth": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "width",
          "height",
          "depth"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "shortDescription": {
            "type": "string",
            "minLength": 5
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "originalPrice": {
            "type": "number",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "enum": [
              "decoracao",
              "geek",
              "presentes",
              "utilidades",
              "personalizados"
            ]
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "images": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductImageDto"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVariantDto"
            }
          },
          "material": {
            "type": "string"
          },
          "productionTime": {
            "type": "number",
            "minimum": 0
          },
          "stock": {
            "type": "number",
            "minimum": 0
          },
          "dimensions": {
            "$ref": "#/components/schemas/DimensionsDto"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "isAvailable": {
            "type": "boolean"
          },
          "isFeatured": {
            "type": "boolean"
          },
          "isCustom": {
            "type": "boolean"
          },
          "badge": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "name",
          "description",
          "shortDescription",
          "price",
          "category",
          "tags",
          "images"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "shortDescription": {
            "type": "string",
            "minLength": 5
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "originalPrice": {
            "type": "number",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "enum": [
              "decoracao",
              "geek",
              "presentes",
              "utilidades",
              "personalizados"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "images": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductImageDto"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVariantDto"
            }
          },
          "material": {
            "type": "string"
          },
          "productionTime": {
            "type": "number",
            "minimum": 0
          },
          "stock": {
            "type": "number",
            "minimum": 0
          },
          "dimensions": {
            "$ref": "#/components/schemas/DimensionsDto"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "isAvailable": {
            "type": "boolean"
          },
          "isFeatured": {
            "type": "boolean"
          },
          "isCustom": {
            "type": "boolean"
          },
          "badge": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "OrderItemEmbed": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "variantName": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
