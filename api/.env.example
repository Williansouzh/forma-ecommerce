# Servidor
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Banco de dados
MONGODB_URI=mongodb://localhost:27017/forma

# Autenticação do painel admin
JWT_SECRET=troque-por-um-segredo-forte
ADMIN_EMAIL=admin@forma.estudio
ADMIN_PASSWORD=forma-admin-2026
ADMIN_NAME=Super Admin

# Popula produtos de demonstração na primeira execução
SEED_DEMO=true

# ── Shopee Open Platform ───────────────────────────────────────────────────
# As credenciais NÃO ficam aqui. `partner_id`, `partner_key`, access token e
# refresh token são gravados pelo painel (Integrações → Shopee) e guardados
# em `integrations.secrets`, com `select: false` — o mesmo cofre do Mercado
# Pago. Um segredo em variável de ambiente aparece em `docker inspect`, em
# `ps` e no log de qualquer processo que despeje o ambiente.
#
# O que o ambiente controla é COMPORTAMENTO, não credencial:

# Desliga o worker de fila, varredura e conciliação neste processo.
# Use "off" ao rodar vários contêineres da API e querer que só um sincronize,
# ou em um ambiente de inspeção que não deve falar com a Shopee.
# SHOPEE_WORKER=off

# A Shopee precisa alcançar PUBLIC_API_URL para entregar os pushes, e essa
# mesma URL entra na base da assinatura do webhook (esquema `authorization`).
# Se ela não bater com a URL cadastrada no console da Shopee, toda notificação
# é recusada por assinatura inválida.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_SITE_URL=http://localhost:3000

# Mongo usado pelos testes de integração (estoque, fila, Shopee).
# Nada é lido nem escrito no banco de produção: cada suíte usa um banco próprio.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27018
